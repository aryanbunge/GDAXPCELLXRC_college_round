{
  "manifest_version": 3,
  "name": "Handsfree Agent",
  "version": "0.1.0",
  "description": "Autopilot, See What I Mean, and Intent Replay for hands-free browsing.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/core.js", "content/matcher.js", "content/refs.js", "content/actions.js",
        "content/ui.js", "content/voice.js", "content/recorder.js", "content/replayer.js", "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Handsfree Agent (toggle panel)" },
  "commands": {
    "toggle-panel": { "suggested_key": { "default": "Alt+H" }, "description": "Toggle the Handsfree panel" }
  }
}
